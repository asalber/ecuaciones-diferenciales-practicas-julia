     "data": {
      "text/latex": [
       "$y{\\left(t \\right)} = y_{0} e^{- t λ}$"
      ],
      "text/plain": [
       "           -t⋅λ\n",
       "y(t) = y₀⋅ℯ    "
      ]
     },
     "execution_count": 22,
