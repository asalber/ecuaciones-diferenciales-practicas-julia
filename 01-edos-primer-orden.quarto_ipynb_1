    "qnum = lambdify(qsol, (t,))\n",
    "qperm(t) = 0.0006 * (cos(10t) + sin(10t))\n",
    "Plots.plot(qnum, 0, 1.5, lw = 2, label = \"Solución completa\",\n",
    "    xlab = L\"t \\; (s)\", ylab = L\"q \\; (C)\")\n",
