       "$A{\\left(t \\right)} = 130000 e^{\\frac{t}{20}} - 120000$"
      ],
      "text/plain": [
       "               t          \n",
       "               ──         \n",
       "               20         \n",
       "A(t) = 130000⋅ℯ   - 120000"
      ]
     },
     "execution_count": 37,
     "metadata": {},
