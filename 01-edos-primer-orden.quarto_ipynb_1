   ],
   "source": [
    "@syms t y() λ::positive y0::positive\n",
    "# Comprobación directa con dsolve:\n",
    "sol = dsolve(Eq(diff(y(t), t), -λ * y(t)), y(t), ics = Dict(y(0) => y0))"
   ]
