   "source": [
    "using SymPyPythonCall\n",
    "@syms t A()\n",
    "sol = dsolve(Eq(diff(A(t), t), Sym(5)/100 * A(t) + 6000), A(t), ics = Dict(A(0) => 10000))"
   ]
