    "using Roots\n",
    "# Máxima desviación:\n",
    "xmax = find_zero(x -> 0.8 * (x/200)^(-0.2) - 1.2 * (x/200)^0.2, 100) / 200 |> \n",
    "        u -> 200u\n",
    "(xmax, traj(xmax))"
