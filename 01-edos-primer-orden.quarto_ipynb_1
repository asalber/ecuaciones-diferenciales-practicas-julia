    "    Plots.plot!(plt, c .+ c .* cos.(θ),  c .* sin.(θ), color = :blue)   # Equipotenciales\n",
    "    Plots.plot!(plt, -c .+ c .* cos.(θ), c .* sin.(θ), color = :blue)\n",
